# Brewfile — dotfiles bootstrap (macOS + Linux/WSL2)
# Install everything on a new machine with:
#   brew bundle install --file=brewfile
# Update this file after installing something new with:
#   brew bundle dump --file=brewfile --force
#
# This file is Ruby, so `if OS.mac?` / `if OS.linux?` guards work. Casks and
# fonts only exist on macOS; on WSL2 the terminal and its font live on the
# Windows side, so those lines are skipped there.

# --- Shell prompt ---
brew "starship"                        # fast, cross-shell prompt (git, lang versions, etc.)

# --- Zsh plugins (sourced directly in .zshrc, no framework needed) ---
brew "zsh-autosuggestions"             # ghost-text suggestions from history
brew "zsh-syntax-highlighting"         # colors valid/invalid commands as you type

# --- Neovim (kickstart-modular.nvim) ---
brew "neovim"                          # editor itself, latest stable required
brew "lazygit"                         # optional, kickstart's git integration plugin uses this

# --- Modern CLI tool replacements ---
brew "eza"                             # better ls (icons, git status, tree)
brew "bat"                             # better cat (syntax highlighting)
brew "fzf"                             # fuzzy finder (Ctrl+R history search)
brew "zoxide"                          # smarter cd, learns your habits
brew "ripgrep"                         # better/faster grep
brew "fd"                              # better/faster find
brew "btop"                            # better top/htop
brew "tree-sitter-cli"

# --- Dotfiles management ---
brew "stow"                            # symlinks dotfiles from repo into $HOME

# --- Optional ---
brew "tmux"                            # terminal multiplexer, skip if you don't need it
brew "gh"
brew "node"
brew "kubectl"
brew "mycli"

# --- macOS only ---
if OS.mac?
  cask "iterm2"                        # terminal (WSL2 uses Windows Terminal instead)
  cask "font-meslo-lg-nerd-font"       # Starship's icons; on WSL2 install this font in Windows
  cask "claude-code"                   # on Linux, install.sh installs it via npm
end
